  "rated_temp": "85℃",
  "title_zh": "MPF 金属化聚丙烯膜 AC 电容器(浸渍型) 85℃",
  "title_en": "MPF Metallized polypropylene film AC capacitor (Dipped) 85℃",
  "type_zh": "金属化聚丙烯膜 AC 电容器(浸渍型)",
  "type_en": "Metallized polypropylene film AC capacitor (Dipped)",
  "summary_zh": "MPF 是东莞博可威电子科技有限公司（BKW）的金属化聚丙烯膜 AC 电容器(浸渍型)，额定温度 85℃，额定电压 160VAC、250VAC、300VAC、400~450VAC，电容量范围 0.47μF~47μF；适用于温度补偿电路、定时与振荡回路、功率校正、开关电源耦合及 AC 滤波；如客户有特别要求，可按客户要求生产。",
  "summary_en": "BKW MPF: Metallized polypropylene film AC capacitor (Dipped). Rated temperature 85℃, rated voltage 160, 250, 300 and 400–450VAC, capacitance 0.47μF–47μF; for temperature compensation, timing and oscillator circuits, power factor correction, SMPS coupling and AC filtering. Special requirements can be produced to customer specification.",
  "applications": [
    {
      "zh": "温度补偿电路",
      "en": "Temperature compensation circuits"
    },
    {
      "zh": "定时，振荡回路",
      "en": "Timing, oscillator circuit"
    },
    {
      "zh": "功率校正，开关电源耦合用",
      "en": "Power factor correction and coupling capacitor in SMPS application"
    },
    {
      "zh": "AC滤波用",
      "en": "AC filter capacitor"
    }
  ],
  "specs": [
    {
      "zh": "电容器类别",
      "en": "Class",
      "value": "MPF(AC)"
    },
    {
      "zh": "引用标准",
      "en": "Reference standard",
      "value": "UL810-2012, IEC60252-1, GB/T3667.1, JIS4908"
    },
    {
      "zh": "额定温度",
      "en": "Rated temperature",
      "value": "85℃"
    },
    {
      "zh": "额定电压 / 容量范围",
      "en": "Rated voltage (Vac) / Capacitance range (μF)",
      "value": "160V: 2~47; 250V: 2~47; 300V: 1~22; 400-450V: 0.47~12"
    },
    {
      "zh": "容量偏差",
      "en": "Capacitance tolerance",
      "value": "±5%(J), ±10%(K), ±20%(M), +10~-0%(T), +10~-5%(U)"
    },
    {
      "zh": "散逸因素",
      "en": "Dissipation Factor",
      "value": "≤0.0020 (1kHz, 25℃, only refer for TC terminal)"
    },
    {
      "zh": "耐电压",
      "en": "Voltage proof",
      "value": "TT: 1.6*U_R(DC), 2s"
    },
    {
      "zh": "绝缘电阻",
      "en": "Insulation Resistance",
      "value": "≥1,000s (100VDC, 60s, 20℃, RH≤65%)"
    }
  ],
  "remark": {
    "zh": "备注：如客户有特别要求，可按客户要求生产。",
    "en": "Note: If the customer has special requirements, it can be produced according to customer requirements."
